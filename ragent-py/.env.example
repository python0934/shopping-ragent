# ============================================================
# Ragent AI Platform - Environment Configuration
# Copy to .env and fill in actual values
# ============================================================

# Server
SERVER_PORT=9090
API_PREFIX=/api/ragent

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ragent

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

# Engine type: rag | agent
ENGINE_TYPE=agent

# Demo mode
DEMO_MODE=false

# Sa-Token equivalent: token timeout (seconds), default 30 days
TOKEN_TIMEOUT=2592000

# File upload limits
MAX_FILE_SIZE_MB=50
MAX_REQUEST_SIZE_MB=100

# ---- AI Providers ----
# Bailian (Alibaba DashScope)
BAILIAN_API_KEY=
# AIHubMix
AIHUBMIX_API_KEY=
# SiliconFlow
SILICONFLOW_API_KEY=
# You.com Web Search
YDC_API_KEY=
# MinerU
MINERU_API_KEY=

# ---- Storage (S3 / OSS) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_KB_BUCKET=ragent-sources
S3_ASSET_BUCKET=ragent-assets

# ---- Milvus (optional) ----
MILVUS_URI=http://localhost:19530
